// Модуль вокруг рукописного заголовка границы.
//
// Нужен затем, что Swift Package Manager и `swiftc` умеют видеть C только
// модулем, а Xcode — ещё и мостовым заголовком. Обёртка написана так, что
// работает и там и там: `import CMethodCore` стоит под `#if canImport`, и при
// мостовом заголовке (когда модуля нет) объявления просто лежат в глобальном
// пространстве имён.
//
// Путь к заголовку относительный — от каталога этого файла. Абсолютный
// сломался бы у всех, кроме одной машины.
module CMethodCore {
    header "../../include/method_core.h"
    export *
}
