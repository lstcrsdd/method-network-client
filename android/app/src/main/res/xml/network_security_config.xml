<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила доверия к сети.

  Android с девятой версии запрещает открытый HTTP. Запрет правильный, и
  снимать его целиком (`usesCleartextTraffic="true"`) нельзя: VPN-клиент,
  которому разрешён открытый HTTP куда угодно, отдаёт содержимое запросов
  любому, кто сидит на канале, — то есть ровно тому, от кого он защищает.

  Исключение сделано для ОДНОГО адреса — локального интерфейса ядра. Через
  него управляющий контур меряет оси и переставляет полосы. Трафик по нему
  не выходит за пределы устройства: собеседник — соседний поток в этом же
  процессе, и шифровать там нечего и не от кого.

  Цена ошибки видна: без этого исключения контур получал
  `Cleartext HTTP traffic to 127.0.0.1 not permitted` на каждом круге,
  молча пропускал его и не решал НИЧЕГО. Туннель при этом работал, весь
  трафик стоял в одном мёртвом маршруте, и снаружи это выглядело как
  «сеть режет наши узлы».
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
