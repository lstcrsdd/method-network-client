<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон диалога.

  Радиус 28dp — тот же, что Material 3 назначил диалогам: они крупнее карточек
  и просят более мягкого угла, иначе на чёрном читаются как вырезанный прямоугольник.

  Цвет светлее фона приложения, а не темнее. В тёмной теме высота выражается
  СВЕТЛОТОЙ: то, что ближе к человеку, ловит больше света. Тёмный диалог поверх
  тёмного фона выглядит дырой, а не листом сверху.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#171C1A" />
    <corners android:radius="28dp" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
