  terms of the GNU General Public License as published by the Free Software
  Foundation, either version 3 of the License, or (at your option) any later
  version. See LICENSE for details.

  Общий язык интерфейса: боковая панель, карточки, заголовки разделов. Один и
  тот же продукт на разных платформах должен выглядеть одинаково, поэтому формы
  и отступы взяты с клиента macOS, а не придуманы заново.

  Значки нарисованы линиями, а не шрифтом значков: шрифт есть не на всякой
  системе, и там, где его нет, вместо значка появляется пустой квадрат.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Method.App.Controls">

  <Styles.Resources>
    <StreamGeometry x:Key="IconHome">M3.5,11.2 L12,4.2 L20.5,11.2 M6.2,9.8 L6.2,20 L17.8,20 L17.8,9.8</StreamGeometry>
    <StreamGeometry x:Key="IconServers">M4.5,5.5 H19.5 V10 H4.5 Z M4.5,14 H19.5 V18.5 H4.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconScenarios">M12,20 V13 M12,13 L6,6 M12,13 L18,6</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M12,8.6 A3.4,3.4 0 1 0 12,15.4 A3.4,3.4 0 1 0 12,8.6 M12,3.2 V5.6 M12,18.4 V20.8 M3.2,12 H5.6 M18.4,12 H20.8 M5.8,5.8 L7.5,7.5 M16.5,16.5 L18.2,18.2 M18.2,5.8 L16.5,7.5 M7.5,16.5 L5.8,18.2</StreamGeometry>
    <StreamGeometry x:Key="IconPower">M12,4 V11.5 M7.8,6.9 A6.7,6.7 0 1 0 16.2,6.9</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M12,5.5 V18.5 M5.5,12 H18.5</StreamGeometry>
    <StreamGeometry x:Key="IconRefresh">M20,12 A8,8 0 1 1 17,6.2 M17.6,2.8 V6.8 H13.6</StreamGeometry>
    <StreamGeometry x:Key="IconLock">M7.5,10.5 V8 A4.5,4.5 0 0 1 16.5,8 V10.5 M5.8,10.5 H18.2 V20 H5.8 Z</StreamGeometry>
    <StreamGeometry x:Key="IconArrowOut">M8,16 L16.5,7.5 M10.5,7.5 H16.5 V13.5</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M5,7 H19 M9.5,7 V4.8 H14.5 V7 M7,7 L8,20 H16 L17,7</StreamGeometry>
    <StreamGeometry x:Key="IconBrand">M9.5,14.5 L14.5,9.5 M8.4,11.6 L6.4,13.6 A2.8,2.8 0 0 0 10.4,17.6 L12.4,15.6 M11.6,8.4 L13.6,6.4 A2.8,2.8 0 0 1 17.6,10.4 L15.6,12.4</StreamGeometry>
    <StreamGeometry x:Key="IconWave">M3,13 C5,7.5 7,7.5 9,13 C11,18.5 13,18.5 15,13 C17,7.5 19,7.5 21,13</StreamGeometry>
    <StreamGeometry x:Key="IconChevron">M6,9 L12,15 L18,9</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M6,12.5 L10,16.5 L18,8</StreamGeometry>

    <!-- Кнопки окна. Своими линиями, а не шрифтом значков: шрифт есть не на
         всякой системе, и там, где его нет, вместо кнопки пустой квадрат. -->
    <StreamGeometry x:Key="IconMinimize">M5,12 H19</StreamGeometry>
    <StreamGeometry x:Key="IconMaximize">M6,6 H18 V18 H6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</StreamGeometry>

    <!-- Пятиконечная звезда. Читается на любом размере, в отличие от всего,
         что внутри неё, — потому в мелких отметках стоит она одна. -->
    <StreamGeometry x:Key="IconStar">M12,2.2 L14.6,9.1 L21.9,9.5 L16.2,14.1 L18.1,21.2 L12,17.2 L5.9,21.2 L7.8,14.1 L2.1,9.5 L9.4,9.1 Z</StreamGeometry>

    <!--
      Знак Method: подъём, спад к середине, подъём, спад. Это и литера «М», и
      ход сигнала — та же ломаная, какой рисуют всплеск на приборе.

      Набрана она одной непрерывной линией: неоновую трубку не разрезают на
      куски, и знак из отдельных штрихов перестаёт читаться трубкой.

      Три коротких штриха под ней — уровень сигнала, тот же ряд, каким его
      рисуют на приборах. Средний спущен на треть длины соседних и сам длиннее
      их: ряд из трёх равных черт читается паузой в наборе, а не знаком. Они лежат в том же пути, а не рядом отдельной
      фигурой: так у них с литерой общая середина, общий масштаб и общий
      свет. Собранные из двух фигур, они разъехались бы на первом же
      изменении размера — ровно этим уже болел знак, пока слои были разными
      путями.
    -->
    <StreamGeometry x:Key="IconMark">M4,17.5 L4,4 L12,12 L20,4 L20,17.5 M8.5,19.8 V23.6 M12,21.1 V26.2 M15.5,19.8 V23.6</StreamGeometry>
  </Styles.Resources>

  <!--
    Флажок. Без этого он остаётся системным — синим в основном оформлении и
    сиреневым в плакатном, где всё остальное красное.
  -->
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!-- Значок: линия одинаковой толщины, скруглённые концы. -->
  <Style Selector="Path.icon">
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
  </Style>

  <!-- Пункт боковой панели -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>


  <!--
    Части, которые есть только в плакатном оформлении: номер раздела в боковой
    панели, плашка марки и имя прописными. Объявлены и здесь, потому что стиль
    обязан их прятать — иначе в основном оформлении рядом с обычной маркой
    висела бы вторая, красная.
  -->
  <Style Selector="TextBlock.navNo">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Прописные буквы — часть плакатного оформления, а не текста:
       в основном наборе показывается обычная надпись. -->
  <Style Selector="TextBlock.capsCaption">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Border.brandPlate">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="TextBlock.brandCaps">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!--
    Корпус окна. Скругление задаёт оформление, а не разметка: у плаката
    углы прямые, и мягкий угол самого окна выдавал бы приложение раньше,
    чем человек успевал посмотреть на его содержимое.
  -->
  <Style Selector="Border.shell">
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- Карточка -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="12" />

    <!-- Отступ между строками задаёт оформление, а не разметка: в плакате
         строки идут сплошной ведомостью, без промежутков. -->
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- Заголовки -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>


  <!--
    Название раздела в плакатном виде: номер и прописные в разрядку. В основном
    оформлении обе части скрыты — там название пишется обычной крупной надписью.
    Держать их здесь, а не на страницах, дешевле: правка идёт в одном месте.
  -->
  <Style Selector="StackPanel.posterTitle">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="TextBlock.headingNumber">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="2.4" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="TextBlock.headingCaps">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!--
    Линейка под шапкой раздела. Приём плаката: заголовок отбит от содержимого
    не пустотой, а краской. В основном оформлении её нет — там разделяет воздух.
  -->
  <!--
    Линия под заголовком раздела. В основном оформлении её не видно — но место
    она занимает, и это не небрежность.

    Отступ между заголовком и первой секцией задают её поля. Спрячь её через
    IsVisible — и вместе с линией исчезнут тридцать три пикселя воздуха:
    подпись секции подъезжает к заголовку вплотную. В плакатном виде страница
    при этом дышит, в основном слипается, и разницу видно только глазами, на
    снимке готовой страницы.
  -->
  <Style Selector="Border.rule">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.3" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- Круглая кнопка действия -->
  <Style Selector="Button.round">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.round:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!--
    Кнопка-пилюля, светлая: главное действие на пустом экране.

    Не чисто белая. Белое пятно на тёмном фоне бьёт по глазам сильнее любого
    акцента и перетягивает внимание с того, ради чего экран открыт.
  -->
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="#F4E7E0" />
    <Setter Property="Foreground" Value="#1B0F12" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="Padding" Value="28,10" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E5D3C9" />
  </Style>

  <!-- Незаметная кнопка-ссылка -->
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Значок кнопки окна: тоньше обычного, он не действие, а рамка. -->
  <Style Selector="Path.chromeIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Кнопка окна -->
  <Style Selector="Button.chrome">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="TextBlock.Foreground" Value="White" />
  </Style>

  <!--
    Тумблер: во включённом виде горит акцентом.

    Раньше он брал цвет связи, и пока связь была того же цвета, что и акцент,
    разницы не было. Теперь она есть: цвет связи в основном наборе холодный и
    занят одним смыслом — «туннель поднят». Тумблер настройки к этому смыслу
    отношения не имеет, и загораться им не должен, иначе включённое
    автоподключение выглядит как состояние сети.
  -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!--
    Полоса прокрутки: не мозолит глаза, но всегда под рукой.

    Прячется прозрачностью, а не сворачиванием ширины: при смене ширины список
    каждый раз пересчитывает разметку и перерисовывается, а это ровно то дрожание
    содержимого, от которого мы избавились в плавной прокрутке. Прозрачность
    разметку не трогает.

    Появляется по наведению на весь список, а не на саму полосу: попасть мышью в
    восемь пикселей, которых не видно, невозможно.
  -->
  <Style Selector="ScrollViewer /template/ ScrollBar">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ScrollViewer:pointerover /template/ ScrollBar">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Курсор на самой полосе или ползунок захвачен — держим видимой. -->
  <Style Selector="ScrollViewer /template/ ScrollBar:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:expanded">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Border#TrackRect">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Thumb">
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
    <Setter Property="Background" Value="#55FFFFFF" />
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
    <Setter Property="Background" Value="#77FFFFFF" />
  </Style>

  <!--
    Кружок выбора узла. Не переключатель и не флажок: выбранный узел ровно
    один, а стандартный переключатель тянет за собой подпись и отступы, которых
    в плотной строке нет.
  -->
  <Style Selector="Button.pick">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.pick:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!--
    Отметка выбранного узла. В основном оформлении это неоновое кольцо — то же,
    что вокруг кнопки подключения, только размером со строку: выбранный узел
    надо находить взглядом сразу, а галочка того же тона, что и весь список,
    заставляла его искать.

    Зажигается быстрее, чем большое кольцо на обзоре: там свет наливается
    вслед за туннелем и оттого медленный, здесь он отвечает на щелчок, и
    задержка читалась бы промахом мимо кнопки.
  -->
  <Style Selector="c|Orbit.pick">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="GlowOpacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!--
    Кольцо-след и звезда — язык плакатного оформления; в основном их место
    занимает неон. Прятать приходится здесь: разметка на оба набора одна.
  -->
  <Style Selector="Ellipse.pickRing">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!--
    Кольцо сжимается к центру при выборе, отметка оттуда же разворачивается.
    Сделано переходами, а не покадровой анимацией: покадровая анимация
    превращения требует своего аниматора и без него роняет окно при разборе
    стилей — проверено. Переход поверх превращения работает и, в отличие от
    покадровой, отыгрывает обратно сам, когда выбор уходит на другой узел.
  -->
  <Style Selector="Ellipse.pickRing">
    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="0:0:0.18" Easing="CubicEaseIn" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.pick.selected Ellipse.pickRing">
    <Setter Property="RenderTransform" Value="scale(0)" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!--
    Отметка ждёт свёрнутой в точку и с поворотом: разворачиваясь, она
    доворачивается на место. Задержка — время, за которое кольцо успевает
    сойтись; без неё они делают своё движение одновременно и получается не
    превращение, а наложение.
  -->
  <Style Selector="Path.mark">
    <Setter Property="RenderTransform" Value="scale(0) rotate(-140deg)" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform"
                                       Duration="0:0:0.34" Delay="0:0:0.12"
                                       Easing="BackEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Delay="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.pick.selected Path.mark">
    <Setter Property="RenderTransform" Value="scale(1) rotate(0deg)" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!--
    Звезда с окантовкой. Обводка на той же фигуре, а не вторая звезда сверху:
    два наложенных пути пришлось бы держать в одном размере и в одной анимации
    вручную, и на повороте они разъезжались бы по полпикселя. Обводка ложится
    по контуру сама и растёт вместе с ним.

    Стык скруглён: у звезды внутренние углы острые, и на тонкой линии
    остроугольный стык даёт длинные шипы наружу.
  -->
  <Style Selector="Path.markStar">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource EmblemBrush}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <!-- Выбор оформления -->
  <Style Selector="Button.skin">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.skin:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.skin.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Поле ввода -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <!-- Поле для ссылок: моноширинное, чтобы длинная строка читалась посимвольно. -->
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="Consolas,monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!--
    Разряды состояния.

    Цвет состояния назначается здесь, а не в модели: оформлений два, и кисть,
    созданная в коде, знает только про одно из них. Модель отдаёт разряд
    («подключено», «идёт», «отказ»), разметка вешает класс, а ссылка на ключ
    здесь динамическая — подмена набора перекрашивает всё сама.

    Порядок объявления — часть договора: базовый разряд идёт первым, условные
    следом, и при равной силе побеждает объявленный позже.
  -->
  <!--
    Точка состояния туннеля. Цвет назначает оформление, а не модель: кисть из
    кода знала бы только про один набор, и в плакатном точка осталась бы
    оранжевой посреди красного.

    Разряды задержки (toneOk и прочие) сюда не годятся — они про качество
    связи, а не про состояние, и раскрашены иначе.
  -->
  <Style Selector="c|StatusDot">
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="GlowBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="GlowOpacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="GlowOpacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
        <BrushTransition Property="Fill" Duration="0:0:0.35" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Туннель поднят: точка горит ровно, как кольцо на кнопке. -->
  <Style Selector="c|StatusDot.on">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    <Setter Property="GlowOpacity" Value="1" />
  </Style>

  <!--
    Поднимается: точка дышит. Движение здесь и есть сообщение — «идёт работа»,
    а не «уже готово»; ровным светом это не сказать.

    Ядро при этом остаётся серым: дышит свечение поверх него. Покрась ядро
    акцентом — и точка станет мигать из оранжевого в оранжевый, то есть
    сообщать «подключено» ещё до того, как туннель поднят.
  -->
  <Style Selector="c|StatusDot.busy">
    <!--
      Переход на время дыхания снимается. Он сглаживает всякое изменение
      свечения, а дышит оно само — и вдвоём они тянут значение каждый в свою
      сторону: размах съедается, и точка вместо «серая — оранжевая» ходит
      «оранжевая — оранжевая поярче».
    -->
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE"
                 PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="GlowOpacity" Value="0.05" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="GlowOpacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Отказ: тот же неон, но своим цветом. -->
  <Style Selector="c|StatusDot.bad">
    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="GlowBrush" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="GlowOpacity" Value="1" />
  </Style>

  <Style Selector="Ellipse.toneMuted">
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Ellipse.toneOk">
    <Setter Property="Fill" Value="{DynamicResource ConnectedBrush}" />
  </Style>
  <Style Selector="Ellipse.toneWarn">
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Ellipse.toneBad">
    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <Style Selector="TextBlock.toneMuted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.toneOk">
    <Setter Property="Foreground" Value="{DynamicResource ConnectedBrush}" />
  </Style>
  <Style Selector="TextBlock.toneWarn">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="TextBlock.toneBad">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <!-- Полоска расхода: пока не подошло к концу — акцентная, а не тревожная. -->
  <Style Selector="ProgressBar.toneAccent">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ProgressBar.toneWarn">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="ProgressBar.toneBad">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <!--
    Пилюли-метки в строке узла: чем узел выделен провайдером и каким способом
    ходит трафик. Радиус здесь, а не в разметке, — иначе плакатное оформление до
    него не дотянется и скруглит то, что должно быть прямым.
  -->
  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    Дальше — то, что раньше объявлялось прямо в страницах.

    Стиль, объявленный внутри страницы, сильнее набора приложения и молча
    перебивает его. Плакатное оформление — это как раз набор приложения, и
    половина его приёмов до экрана не долетала: кнопка подключения оставалась
    круглой, хотя плакат просил печать. Поэтому правило простое: страницы стилей
    не объявляют, всё живёт здесь, а оформление перекрывает это на равных.
  -->

  <!-- Кнопка подключения -->
  <!--
    Отступы обнулены намеренно. Готовая тема даёт кнопке несимметричное поле —
    сверху пять точек, снизу шесть, — и знак внутри круга вставал на пиксель
    выше середины. На прямоугольной кнопке с текстом этого не видно, на круглой
    с одним знаком в середине видно сразу.
  -->
  <Style Selector="Button.connect">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="152" />
    <Setter Property="Height" Value="152" />
    <Setter Property="CornerRadius" Value="76" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!--
    Подсветка при наведении наливается, а не вспыхивает. Кисти меняются
    переходом: без него кант щёлкает с приглушённого на акцентный за один кадр,
    и это читается не откликом, а рывком отрисовки — тем заметнее, что кнопка
    здесь крупная и в середине экрана.

    Переход объявлен у ContentPresenter, а не у самой кнопки: заливку и кант
    рисует он, на нём же их и надо сглаживать.
  -->
  <Style Selector="Button.connect /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.22" Easing="CubicEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.connect:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!--
    Лёгкое сжатие при нажатии: движение подтверждает, что кнопка сработала.

    Заливку при этом держим свою. Готовая тема на нажатие красит кнопку в
    служебный серый — на белом фоне он уместен, а здесь диск на секунду
    выцветал в камень, и выглядело это не нажатием, а зависанием.
  -->
  <Style Selector="Button.connect:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button.connect:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!--
    Надпись и значок внутри диска загораются тем же светом, что и кольцо:
    наведение зажигает их заранее, поднятый туннель держит зажжёнными. Переход
    по кисти — та же плавность, что у подсветки канта; цвет здесь и есть
    состояние, поэтому щёлкать ему нельзя.
  -->
  <Style Selector="Button.connect">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.35" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!--
    Надпись и значок остаются светлыми, горит воздух вокруг них. Так устроена
    неоновая вывеска: трубка белёсая, светится оболочка. Покрась саму букву
    цветом свечения — выйдет не подсветка, а перекрашенная надпись, вдобавок
    размытая собственным ореолом.

    Поэтому цвет содержимого при наведении лишь чуть подаётся вперёд, до
    основного текстового, а всю работу делает ореол.
  -->
  <Style Selector="Button.connect:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.connect.lit">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!--
    Знак внутри диска зажигается тем же светом, что и кольцо: наведение
    зажигает его заранее, поднятый туннель держит зажжённым. Слои трубки —
    ореол, средний, нить — рисует сам контрол одним путём; стилям остаётся
    сказать, горит знак или нет.
  -->
  <Style Selector="c|NeonMark.mark">
    <Setter Property="GlowOpacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="GlowOpacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.connect:pointerover c|NeonMark.mark">
    <Setter Property="GlowOpacity" Value="1" />
  </Style>

  <Style Selector="Button.connect.lit c|NeonMark.mark">
    <Setter Property="GlowOpacity" Value="1" />
  </Style>

  <!--
    Ореол надписи зажигается вместе с цветом: погашенная надпись остаётся просто
    надписью, горящая обрастает свечением. Плавность — тем же переходом по
    вещественному свойству, что и у кольца.
  -->
  <Style Selector="c|NeonText">
    <Setter Property="GlowOpacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="GlowOpacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.connect:pointerover c|NeonText">
    <Setter Property="GlowOpacity" Value="1" />
  </Style>

  <Style Selector="Button.connect.lit c|NeonText">
    <Setter Property="GlowOpacity" Value="1" />
  </Style>

  <!--
    Площадка под кнопкой и её гало. Высота стоит здесь, а не в разметке
    страницы: в плакатном оформлении знак крупнее, и площадке нужно больше
    места — а заданное в разметке значение оформлению не перебить.
  -->
  <Style Selector="Panel.dialArea">
    <Setter Property="Width" Value="380" />
    <Setter Property="Height" Value="330" />
  </Style>

  <!--
    Неон разгорается и гаснет плавно, а не щёлкает. Секунда с небольшим: за это
    время трубка и правда набирает свет, и глаз успевает заметить, что
    состояние сменилось, — мгновенная вспышка читается сбоем отрисовки.

    Плавность даёт переход по вещественному свойству. Такие Avalonia умеет
    анимировать сама; преобразования — нет, на них клиент уже падал при
    попытке раскрутить это же кольцо.
  -->
  <Style Selector="c|Orbit">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="GlowOpacity" Duration="0:0:1.1" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>


  <!-- Показатель на обзоре: время, адрес, протокол. -->
  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,14" />

    <!-- Ширину задаёт колонка обзора, здесь только нижняя граница на случай
         узкого окна. -->
    <Setter Property="MinWidth" Value="150" />
  </Style>

  <!-- Строка узла отзывается на курсор: список длинный, попасть нужно точно. -->
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>

  <!-- Выбор пути в сценариях: выглядит как список, но пока не раскрывается. -->
  <Style Selector="Border.lane">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <Style Selector="Border.soon">
    <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Кнопки окна импорта: подтверждающая и отменяющая. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="18,8" />
  </Style>

</Styles>
