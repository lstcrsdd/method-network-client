  Значения взяты из клиента macOS: цвет у Method один на все платформы, и
  подбирать его заново на каждой означало бы получить три разных продукта.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Фон -->
  <Color x:Key="BackgroundTopColor">#0D0D0D</Color>
  <Color x:Key="BackgroundBottomColor">#060606</Color>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#0A0A0A" />

  <SolidColorBrush x:Key="SidebarBrush" Color="White" Opacity="0.03" />
  <SolidColorBrush x:Key="ChipBrush" Color="White" Opacity="0.08" />

  <!-- Стекло -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="White" Opacity="0.04" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="White" Opacity="0.06" />
  <SolidColorBrush x:Key="GlassStrokeBrush" Color="White" Opacity="0.08" />
  <SolidColorBrush x:Key="HoverBrush" Color="White" Opacity="0.06" />

  <!-- Текст -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="White" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="White" Opacity="0.42" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="White" Opacity="0.28" />

  <!-- Акцент. Зелёный, а не синий: это фирменный цвет Method. -->
  <Color x:Key="AccentColor">#2ECC4D</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="#2ECC4D" />
  <SolidColorBrush x:Key="ConnectedBrush" Color="#29C940" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFBD2E" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FF5E57" />

  <!--
    Что писать поверх акцентной заливки. Здесь акцент светлый, и текст по нему
    тёмный; в плакатном наборе всё наоборот. Ключ нужен именно потому, что
    правильный ответ у наборов разный, а стиль кнопки один на оба.
  -->
  <SolidColorBrush x:Key="OnAccentBrush" Color="#0A0A0A" />

  <!-- Латунь для эмблемы. В основном оформлении не используется, но ключ обязан
       существовать: разметка одна на оба, и ссылка на отсутствующий ключ выдала
       бы пустое место вместо рисунка. -->
  <SolidColorBrush x:Key="EmblemBrush" Color="#D2B778" />

</ResourceDictionary>
