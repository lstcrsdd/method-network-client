  Надстройка над общими стилями: формы и типографика плаката. Подключается
  поверх Controls.axaml, поэтому меняет только то, что перечислено здесь, —
  разметка страниц одна на оба оформления, и расходиться им негде.

  Главный приём — отказ от скруглений. Мягкий угол читается как «приложение»,
  прямой — как «плакат»; это одно изменение отличает два оформления сильнее,
  чем любая замена цвета.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Method.App.Controls">

  <!-- Карточки и строки: прямые углы, заметная рамка. -->
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
  </Style>

  <Style Selector="Border.row:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!--
    Заголовок раздела: крупнее и в разрядку. Плакатная типографика держится на
    величине и воздухе между буквами, а не на начертании — своего шрифта у нас
    нет, и тащить его в поставку ради оформления не стоит.
  -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="LetterSpacing" Value="1.5" />
  </Style>

  <!-- Подписи разделов красные: ими размечена вся страница. -->
  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="LetterSpacing" Value="2" />
  </Style>

  <!-- Пункт боковой панели: активный отмечен красной планкой слева. -->
  <Style Selector="Button.nav">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.nav.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!-- Главное действие: красный прямоугольник, кремовый текст. -->
  <Style Selector="Button.pill">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="30,11" />
  </Style>
  <!-- Под курсором краска ложится плотнее: тот же тон, но темнее на треть. -->
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#A34438" />
  </Style>

  <Style Selector="Button.round">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.quiet">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!--
    Кнопка подключения здесь — сам знак. Ни фона, ни рамки: шестерня уже
    служит оправой, а обод вокруг обода читался бы небрежностью, а не приёмом.
    По той же причине скрыто кольцо-циферблат.
  -->
  <Style Selector="Button.connect">
    <Setter Property="Width" Value="204" />
    <Setter Property="Height" Value="204" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.connect /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Panel.dialRound">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Знак вместо значка питания; подпись действия уходит под кнопку. -->
  <Style Selector="c|Emblem.emblem">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Width" Value="204" />
    <Setter Property="Height" Value="204" />
  </Style>
  <Style Selector="StackPanel.powerFace">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TextBlock.posterAction">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!--
    Отклик на курсор. Без него знак остаётся картинкой: рука понимает, что
    элемент живой, именно по тому, что он отвечает на наведение.
  -->
  <Style Selector="Button.connect:pointerover c|Emblem.emblem">
    <Setter Property="FieldBrush" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>

  <Style Selector="Border.lane">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Border.soon">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.soon > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!--
    Показатели на обзоре и пилюли-метки. Раньше их скругление стояло в разметке
    страницы, куда оформление не дотягивалось, и на плакате они оставались
    мягкими среди прямых углов.
  -->
  <Style Selector="Border.stat">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.tag">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Кнопки окна импорта. -->
  <Style Selector="Button.primary">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.skin">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!--
    В кружке выбора вместо галочки звезда. Только звезда: серп и молот на
    четырнадцати пикселях превращаются в пятно, и узнаётся там ровно контур.
    Полная эмблема живёт на кнопке подключения, где ей хватает размера.
  -->
  <Style Selector="Path.markCheck">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Path.markStar">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Thumb">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Margin" Value="3,0" />
  </Style>

  <!-- Тумблер во включённом виде красный, как и всё работающее. -->
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>

</Styles>
