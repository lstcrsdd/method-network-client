  Обзор — единственный раздел, где оформления расходятся не отделкой, а
  устройством экрана, поэтому каждое из них живёт своей разметкой, а страница
  только подставляет нужную. Прятать вторую видимостью нельзя: знак крутит
  шестерню по таймеру, и невидимая композиция крутила бы её впустую всё время,
  пока поднят туннель.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Method.App.ViewModels"
             x:Class="Method.App.Views.Pages.OverviewPage"
             x:DataType="vm:MainViewModel">
  <Panel Name="Host" />
</UserControl>
