<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Method.App.ViewModels"
             xmlns:c="using:Method.App.Controls"
             x:Class="Method.App.Views.Pages.OverviewPage"
             x:DataType="vm:MainViewModel">

  <!--
    Прокрутка нужна не ради длины страницы, а ради нижнего края: при малом окне
    и поднятом туннеле карточка трафика оказывалась за границей и просто не
    показывалась. Высота содержимого привязана к видимой области, иначе внутри
    прокрутки растяжки схлопнутся в ноль и знак перестанет стоять по центру.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" c:SmoothScroll.Enabled="True"
                Padding="40,10,40,24">
  <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,*"
        MinHeight="{Binding $parent[ScrollViewer].Viewport.Height}">

    <!--
      Циферблат и кнопка. Размеры всей композиции переключает оформление по
      состоянию окна: в обычном окне они те, под которые её собирали, в
      развёрнутом — крупнее, иначе знак тонул бы в пустоте на весь экран.

      Масштабировать это коробкой Viewbox нельзя: страница лежит в прокрутке,
      а та отдаёт содержимому неограниченную высоту — коробка бралась
      подгонять композицию по ширине окна, раздувала её и выталкивала карточки
      за нижний край.
    -->
    <Panel Grid.Row="1" Name="Stage" Classes="dialArea">
      <!-- Гало под кнопкой: круг в основном оформлении, лучи в плакатном. -->
      <Ellipse Classes="glow"
               Fill="{DynamicResource ConnectedBrush}"
               IsVisible="{Binding IsConnected}" />

      <c:Rays Name="StageRays" Classes="rays" IsActive="{Binding IsConnected}"
              RayBrush="{DynamicResource AccentBrush}" />

      <c:Banners Name="StageBanners" Classes="banners"
                 ClothBrush="{DynamicResource AccentBrush}"
                 PoleBrush="{DynamicResource EmblemOutlineBrush}" />

      <!--
        Кольцо-циферблат. Штрихи нарисованы пунктиром по окружности, а не шестью
        десятками отдельных чёрточек: та же картинка, но одна фигура вместо шести
        десятков и никакой возни с углами.

        В плакатном оформлении кольцо скрыто: там его работу выполняет сам знак,
        а два кольца вокруг одной кнопки — это уже не мишень, а стрельбище.
      -->
      <Panel Classes="dialRound">
        <Ellipse Width="292" Height="292" StrokeThickness="9"
                 Stroke="{DynamicResource GlassStrokeBrush}"
                 StrokeDashArray="0.10,0.60" StrokeLineCap="Round" />

        <Ellipse Width="292" Height="292" StrokeThickness="9"
                 Stroke="{DynamicResource ConnectedBrush}"
                 StrokeDashArray="0.10,0.60" StrokeLineCap="Round"
                 Opacity="0.75" IsVisible="{Binding IsConnected}" />
      </Panel>

      <Button Name="ConnectButton" Classes="connect" Command="{Binding ToggleCommand}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Panel>
          <!--
            Две личины одной кнопки. В основном оформлении — значок питания с
            подписью, как на других платформах. В плакатном — знак во всю
            кнопку: шестерня сама себе оправа, и вторая рамка вокруг неё была бы
            лишней, поэтому там кнопка теряет фон и рамку, а подпись уходит вниз
            под знак. Видимостью распоряжается оформление, а не разметка.
          -->
          <c:Emblem Name="StageEmblem" Classes="emblem"
                    Wreath="Wheat"
                    IsJammed="{Binding IsBusy}" IsRunning="{Binding IsConnected}"
                    IsNudged="{Binding $parent[Button].IsPointerOver}"
                    FrameBrush="{DynamicResource AccentBrush}"
                    FlagBrush="{DynamicResource EmblemFlagBrush}"
                    OutlineBrush="{DynamicResource EmblemOutlineBrush}"
                    ToolBrush="{DynamicResource EmblemBrush}"
                    LetterBrush="{DynamicResource EmblemBrush}"
                    FieldBrush="{DynamicResource SurfaceBrush}"
                    CutBrush="{DynamicResource EmblemOutlineBrush}" />

          <StackPanel Classes="powerFace" Spacing="9">
            <Path Data="{DynamicResource IconPower}" Stretch="Uniform"
                  Width="30" Height="30"
                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                  Stroke="{Binding $parent[Button].Foreground}"
                  HorizontalAlignment="Center" />

            <TextBlock Text="{Binding ActionText}" FontSize="10.5" LetterSpacing="1.4"
                       FontWeight="SemiBold" HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
      </Button>
      <!-- Подпись действия для плакатного оформления: там она не помещается
           внутри кнопки, потому что кнопку целиком занимает знак. Стоит внутри
           коробки, поэтому растёт вместе со знаком. -->
      <TextBlock Name="ActionCaption" Classes="posterAction" Text="{Binding ActionText}"
                 FontSize="11.5" LetterSpacing="2.2" FontWeight="Bold"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="0,0,0,4" />
    </Panel>

    <!-- Что сейчас выбрано и куда добавлять -->
    <StackPanel Grid.Row="2" Spacing="4" Margin="0,16,0,0" HorizontalAlignment="Center">
      <TextBlock Text="{Binding SelectedName}" FontSize="13.5" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 IsVisible="{Binding HasServers}" />
      <Button Classes="quiet" Command="{Binding GoToCommand}" CommandParameter="Servers"
              HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Path Data="{DynamicResource IconPlus}" Stretch="Uniform" Width="15" Height="15"
                StrokeThickness="2" StrokeLineCap="Round"
                Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
          <TextBlock Text="Добавить конфигурацию" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Три показателя -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="14"
                HorizontalAlignment="Center" Margin="0,26,0,0">
      <Border Classes="stat">
        <StackPanel Spacing="6">
          <TextBlock Classes="sectionLabel" Text="ВРЕМЯ" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Elapsed}" FontSize="19" FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
      </Border>
      <Border Classes="stat">
        <StackPanel Spacing="6">
          <TextBlock Classes="sectionLabel" Text="IP-АДРЕС" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ExternalIp}" FontSize="19" FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
      </Border>
      <Border Classes="stat">
        <StackPanel Spacing="6">
          <TextBlock Classes="sectionLabel" Text="ПРОТОКОЛ" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ProtocolName}" FontSize="19" FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!--
      Трафик. Карточка стоит здесь всегда, в любом состоянии: появляясь только
      при подключении, она перекраивала страницу ровно в тот момент, когда
      человек смотрит на кнопку, — всё под ней скакало вниз. Что показывать в
      цифрах, решает модель: ноль, когда туннеля нет, и прочерк, когда туннель
      чужой и считать нечем.
    -->
    <Border Grid.Row="4" Classes="card" Padding="20,16" Margin="0,20,0,0"
            Width="480" HorizontalAlignment="Center" VerticalAlignment="Top">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,*,*">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionLabel" Text="ПРИЁМ" />
            <TextBlock Text="{Binding DownSpeed}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource ConnectedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="sectionLabel" Text="ОТДАЧА" />
            <TextBlock Text="{Binding UpSpeed}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Classes="sectionLabel" Text="ЗА СЕССИЮ" />
            <TextBlock Text="{Binding SessionVolume}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </Grid>

        <Panel Height="46">
          <c:Sparkline Values="{Binding DownHistoryView}" Stroke="{DynamicResource ConnectedBrush}" />
          <c:Sparkline Values="{Binding UpHistoryView}" Stroke="{DynamicResource AccentBrush}" />
        </Panel>
      </StackPanel>
    </Border>

    <!-- Ошибка или предупреждение. Молчать здесь нельзя. -->
    <TextBlock Grid.Row="5" Text="{Binding Detail}" Margin="0,22,0,0"
               FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Foreground="{DynamicResource TextSecondaryBrush}"
               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
  </ScrollViewer>
</UserControl>
