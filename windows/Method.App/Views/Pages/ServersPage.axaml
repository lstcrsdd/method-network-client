<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Method.App.ViewModels"
             xmlns:c="using:Method.App.Controls"
             x:Class="Method.App.Views.Pages.ServersPage"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!--
      Строка узла одна на все списки: и внутри подписки, и среди добавленных
      ссылкой. Команды берутся у окна, а не у ближайшего списка — внутри подписки
      ближайший список принадлежит ей, и путь до модели оттуда другой.
    -->
    <DataTemplate x:Key="ServerRow" x:DataType="vm:ServerItem">
      <Border Classes="row" Margin="0,0,0,6" Padding="14,11">
        <Border.Styles>
          <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
          </Style>
        </Border.Styles>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

          <c:CountryFlag Grid.Column="0" Code="{Binding CountryCode}" Width="26" Height="18"
                         FallbackForeground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,14,0" />

          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis" />
              <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="4"
                      Padding="6,1" VerticalAlignment="Center"
                      IsVisible="{Binding IsFeatured}">
                <TextBlock Text="{Binding FeaturedLabel}" FontSize="9"
                           Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                         Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Border Background="{DynamicResource ChipBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Transport}" FontSize="9"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Задержка. До первого замера пусто: прочерк читался бы как «нет ответа». -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7"
                      VerticalAlignment="Center" Margin="12,0,14,0"
                      IsVisible="{Binding HasPing}">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{Binding PingBrush}" />
            <TextBlock Text="{Binding PingText}" FontSize="12"
                       Foreground="{Binding PingBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <Border Grid.Column="3" Width="22" Height="22" CornerRadius="11"
                  Background="{DynamicResource ConnectedBrush}" VerticalAlignment="Center"
                  Margin="0,0,10,0" IsVisible="{Binding IsSelected}">
            <Path Data="{DynamicResource IconCheck}" Stretch="Uniform" Width="12" Height="12"
                  StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round"
                  Stroke="#0A0A0A" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="quiet" Content="Выбрать" VerticalAlignment="Center"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectCommand}"
                    CommandParameter="{Binding}"
                    IsVisible="{Binding !IsSelected}" />
            <Button Classes="quiet" ToolTip.Tip="Удалить" VerticalAlignment="Center"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveCommand}"
                    CommandParameter="{Binding}">
              <Path Data="{DynamicResource IconTrash}" Stretch="Uniform" Width="15" Height="15"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="{DynamicResource ErrorBrush}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!--
      Блок одной страны: тонкая подпись и её узлы. Флаг остаётся на строках, а
      не переезжает в подпись: он и так стоит первым в строке, и дублировать его
      заголовком значит показать один и тот же флаг по четыре раза подряд.
    -->
    <DataTemplate x:Key="CountryBlock" x:DataType="vm:CountryGroup">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Classes="sectionLabel" Text="{Binding Header}" Margin="2,0,0,7" />
        <ItemsControl ItemsSource="{Binding Servers}" ItemTemplate="{StaticResource ServerRow}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="40,10,40,32" RowDefinitions="Auto,*">

    <!-- Заголовок и действия -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,22">
      <TextBlock Classes="pageTitle" Text="Серверы" VerticalAlignment="Center" />

      <Button Grid.Column="1" Classes="quiet" Margin="0,0,6,0" VerticalAlignment="Center"
              Command="{Binding RefreshAllSubscriptionsCommand}"
              IsVisible="{Binding HasSubscriptions}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Path Data="{DynamicResource IconRefresh}" Stretch="Uniform" Width="15" Height="15"
                StrokeThickness="1.8" StrokeLineCap="Round"
                Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
          <TextBlock Text="Обновить всё" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button Grid.Column="2" Classes="quiet" Margin="0,0,10,0" VerticalAlignment="Center"
              Content="Замерить задержки"
              Command="{Binding MeasurePingsCommand}"
              IsVisible="{Binding HasServers}" />

      <Button Grid.Column="3" Classes="round" Click="OnAdd" ToolTip.Tip="Добавить по ссылке"
              VerticalAlignment="Center">
        <Path Classes="icon" Data="{DynamicResource IconPlus}"
              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" />
      </Button>
    </Grid>

    <!--
      Пусто на первом запуске, и это не заглушка: клиент работает с вашими
      собственными серверами, встроенного каталога у него нет.
    -->
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16" IsVisible="{Binding IsEmpty}">
      <Path Data="{DynamicResource IconServers}" Stretch="Uniform" Width="44" Height="44"
            StrokeThickness="1" StrokeLineCap="Round" StrokeJoin="Round"
            Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
      <TextBlock Text="Нет конфигураций" FontSize="16" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" FontSize="12.5"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="Вставьте ссылку hysteria2://, vless://, trojan:// или ss:// либо адрес подписки (https://…) — можно сразу несколько, по одной в строке." />
      <Button Classes="pill" Content="Добавить" Click="OnAdd" HorizontalAlignment="Center" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding HasServers}" VerticalScrollBarVisibility="Auto"
                  c:SmoothScroll.Enabled="True">
      <StackPanel Spacing="14">

        <!-- Группы подписок -->
        <ItemsControl ItemsSource="{Binding Subscriptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubscriptionItem">
              <Border Classes="card" Padding="14,12" Margin="0,0,0,10">
                <StackPanel Spacing="10">

                  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Margin="2,0,10,0" Fill="{Binding StatusBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding ServerCountText}" FontSize="11.5"
                               Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="3" Classes="quiet" ToolTip.Tip="Обновить"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RefreshSubscriptionCommand}"
                            CommandParameter="{Binding}">
                      <Path Data="{DynamicResource IconRefresh}" Stretch="Uniform" Width="15" Height="15"
                            StrokeThickness="1.8" StrokeLineCap="Round"
                            Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Button>

                    <Button Grid.Column="4" Classes="quiet" ToolTip.Tip="Удалить подписку"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveSubscriptionCommand}"
                            CommandParameter="{Binding}">
                      <Path Data="{DynamicResource IconTrash}" Stretch="Uniform" Width="15" Height="15"
                            StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                            Stroke="{DynamicResource ErrorBrush}" />
                    </Button>
                  </Grid>

                  <StackPanel Spacing="3" Margin="20,-4,0,0">
                    <TextBlock Text="{Binding StatusLine}" FontSize="11.5"
                               Foreground="{Binding StatusBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Announce}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding HasAnnounce}" />
                  </StackPanel>

                  <!-- Остаток трафика и срок — то, что провайдер прислал заголовками. -->
                  <StackPanel Spacing="6" Margin="20,2,0,0" IsVisible="{Binding HasTraffic}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding TrafficText}" FontSize="11.5"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding ExpiryText}" FontSize="11.5"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 IsVisible="{Binding HasExpiry}" />
                    </Grid>
                    <ProgressBar Height="4" CornerRadius="2" Minimum="0" Maximum="1"
                                 Value="{Binding TrafficFraction}"
                                 Foreground="{Binding TrafficBrush}"
                                 Background="{DynamicResource SurfaceRaisedBrush}" />
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding Countries}"
                                ItemTemplate="{StaticResource CountryBlock}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Добавленные ссылкой -->
        <StackPanel Spacing="10" IsVisible="{Binding HasLooseServers}">
          <TextBlock Classes="sectionLabel" Text="ДОБАВЛЕНЫ ССЫЛКОЙ" Margin="4,0,0,0"
                     IsVisible="{Binding HasSubscriptions}" />
          <ItemsControl ItemsSource="{Binding LooseCountries}"
                        ItemTemplate="{StaticResource CountryBlock}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
