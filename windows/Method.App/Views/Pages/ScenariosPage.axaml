  Раздел показывает то, что клиент делает на самом деле. Сверху — правила,
  которые ставит сам клиент: их не убрать, потому что без них туннель либо не
  поднимется, либо оставит без сети локальные устройства. Ниже — правила
  человека, в том порядке, в каком их применяет движок.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Method.App.ViewModels"
             xmlns:c="using:Method.App.Controls"
             x:Class="Method.App.Views.Pages.ScenariosPage"
             x:DataType="vm:MainViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto" c:SmoothScroll.Enabled="True">
    <StackPanel Margin="40,10,40,32">

      <c:PageHeading Number="03" Text="Сценарии" HorizontalAlignment="Left" />
      <Border Classes="rule" Margin="0,11,0,14" />

      <TextBlock Classes="subtitle" Margin="0,0,0,22" TextWrapping="Wrap" MaxWidth="640"
                 HorizontalAlignment="Left"
                 Text="Что вести мимо туннеля, а что — в него. Движок применяет первое подошедшее правило, поэтому порядок сверху вниз и есть порядок применения." />

      <!-- Своё правило -->
      <Border Classes="card" Padding="16,14" Margin="0,0,0,22">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox Name="RuleBox" Text="{Binding NewRuleValue}"
                     Watermark="example.com, 192.168.0.0/16 или chrome.exe"
                     VerticalContentAlignment="Center" />

            <!--
              Выбор программы — то, чего нет ни на макоси, ни на телефоне:
              движок на Windows умеет сопоставлять соединение с исполняемым
              файлом. Вписать имя руками тоже можно, кнопка избавляет от
              необходимости его помнить.
            -->
            <Button Grid.Column="1" Classes="quiet" Margin="10,0,0,0" Click="OnPickProgram"
                    ToolTip.Tip="Выбрать программу на диске">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{DynamicResource IconPlus}" Stretch="Uniform" Width="14" Height="14"
                      StrokeThickness="2" StrokeLineCap="Round"
                      Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                <TextBlock Text="Программа" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!--
              Направление выбирается до добавления, а не после: правило без
              направления бессмысленно, и спрашивать о нём вдогонку значит
              заставлять исправлять только что созданное.
            -->
            <Button Grid.Column="2" Classes="quiet" Margin="10,0,0,0"
                    ToolTip.Tip="Куда отправлять то, что подошло под правило">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Data="{DynamicResource IconArrowOut}" Stretch="Uniform" Width="15" Height="15"
                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                      Stroke="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NewRuleAimText}" VerticalAlignment="Center" />
              </StackPanel>

              <Button.Flyout>
                <MenuFlyout ItemsSource="{Binding NewRuleTargets}">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                  x:DataType="vm:RuleTarget">
                      <Setter Property="Header" Value="{Binding Title}" />
                      <Setter Property="Command" Value="{Binding ApplyCommand}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Grid.Column="3" Classes="pill" Margin="10,0,0,0" Content="Добавить"
                    Command="{Binding AddRuleCommand}" IsDefault="True" />
          </Grid>

          <TextBlock Text="{Binding RuleError}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource ErrorBrush}"
                     IsVisible="{Binding RuleError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource WarningBrush}"
                     IsVisible="{Binding RulesPending}"
                     Text="Туннель поднят: правила применятся при следующем подключении." />
        </StackPanel>
      </Border>

      <!-- Правила человека -->
      <TextBlock Classes="sectionLabel" Text="ВАШИ ПРАВИЛА" Margin="0,0,0,10"
                 IsVisible="{Binding HasRules}" />

      <ItemsControl ItemsSource="{Binding Rules}" Margin="0,0,0,22" IsVisible="{Binding HasRules}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RuleItem">
            <Border Classes="row" Padding="16,13">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=OneWay}"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleRuleCommand}"
                          CommandParameter="{Binding}"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          ToolTip.Tip="Выключенное правило остаётся в списке, но в туннель не идёт" />

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Value}" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding MatchText}" FontSize="11.5"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <!--
                  Назначение выбирается списком, а не переключателем: кроме
                  «мимо» и «в туннель» правило может уйти через названный узел —
                  свою полосу, — и перебирать их по кругу нажатиями было бы
                  издевательством при десятке узлов.
                -->
                <Button Grid.Column="2" Classes="lane" VerticalAlignment="Center" Margin="0,0,8,0"
                        ToolTip.Tip="Куда отправлять: мимо туннеля, в туннель или через выбранный узел">
                  <TextBlock Text="{Binding AimText}" FontSize="12"
                             Foreground="{DynamicResource TextPrimaryBrush}" />

                  <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding Targets}">
                      <MenuFlyout.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                      x:DataType="vm:RuleTarget">
                          <Setter Property="Header" Value="{Binding Title}" />
                          <Setter Property="Command" Value="{Binding ApplyCommand}" />
                        </ControlTheme>
                      </MenuFlyout.ItemContainerTheme>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>

                <Button Grid.Column="3" Classes="quiet" VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveRuleCommand}"
                        CommandParameter="{Binding}">
                  <Path Data="{DynamicResource IconTrash}" Stretch="Uniform" Width="15" Height="15"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                        Stroke="{Binding $parent[Button].Foreground}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Правила клиента -->
      <TextBlock Classes="sectionLabel" Text="СТАВИТ КЛИЕНТ" Margin="0,0,0,10" />

      <StackPanel Spacing="8">

        <Border Classes="row" Padding="16,13">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0" Data="{DynamicResource IconArrowOut}" Stretch="Uniform"
                  Width="18" Height="18" StrokeThickness="1.6" StrokeLineCap="Round"
                  StrokeJoin="Round" Stroke="{DynamicResource WarningBrush}"
                  VerticalAlignment="Center" Margin="0,0,12,0" />

            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Адрес самого сервера" FontSize="13.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Иначе пакеты к нему ушли бы в туннель, который они же и поднимают"
                         FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Grid.Column="2" Classes="lane" VerticalAlignment="Center">
              <TextBlock Text="мимо туннеля" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
          </Grid>
        </Border>

        <Border Classes="row" Padding="16,13">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0" Data="{DynamicResource IconArrowOut}" Stretch="Uniform"
                  Width="18" Height="18" StrokeThickness="1.6" StrokeLineCap="Round"
                  StrokeJoin="Round" Stroke="{DynamicResource WarningBrush}"
                  VerticalAlignment="Center" Margin="0,0,12,0" />

            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Локальная сеть" FontSize="13.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Принтеры, хранилища и шлюз в домашней сети" FontSize="11.5"
                         Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Grid.Column="2" Classes="lane" VerticalAlignment="Center">
              <TextBlock Text="мимо туннеля" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
          </Grid>
        </Border>

        <Border Classes="row" Padding="16,13">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0" Data="{DynamicResource IconLock}" Stretch="Uniform"
                  Width="18" Height="18" StrokeThickness="1.6" StrokeLineCap="Round"
                  StrokeJoin="Round" Stroke="{DynamicResource ConnectedBrush}"
                  VerticalAlignment="Center" Margin="0,0,12,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="Весь трафик" FontSize="13.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <Border Classes="tag" Padding="7,2">
                <TextBlock Text="всё остальное" FontSize="9.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </Border>
            </StackPanel>

            <Border Grid.Column="2" Classes="lane" VerticalAlignment="Center">
              <TextBlock Text="через туннель" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
          </Grid>
        </Border>

      </StackPanel>

      <Border Classes="card" Padding="16,14" Margin="0,20,0,0">
        <StackPanel Spacing="6">
          <TextBlock Text="Как это работает" FontSize="13"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Classes="subtitle" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                     Text="Домен ловится вместе с поддоменами: правило на example.com относится и к www.example.com. Адрес можно писать и одиночным — 8.8.8.8 равносильно 8.8.8.8/32. Ваши правила применяются раньше правила о локальной сети, поэтому домашние адреса при желании можно завернуть в туннель. Единственное, что не перебить — адрес самого сервера." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
