  version. See LICENSE for details.

  Раздел показывает то, что клиент делает на самом деле, а не то, что он будет
  уметь. Правила здесь пока неизменяемые — ровно три, и ровно они и попадают в
  конфигурацию движка. Редактируемый список появится вместе с движком выбора
  маршрута; рисовать его раньше значило бы обещать поведение, которого нет.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Method.App.ViewModels"
             xmlns:c="using:Method.App.Controls"
             x:Class="Method.App.Views.Pages.ScenariosPage"
             x:DataType="vm:MainViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto" c:SmoothScroll.Enabled="True">
  <Grid Margin="40,10,40,32" RowDefinitions="Auto,Auto,Auto">

    <TextBlock Grid.Row="0" Classes="pageTitle" Text="Сценарии" />

    <TextBlock Grid.Row="1" Classes="subtitle" Margin="0,8,0,22" TextWrapping="Wrap" MaxWidth="640"
               HorizontalAlignment="Left"
               Text="Правило называет путь, а не сервер. Какой маршрут ему сегодня соответствует — решает клиент." />

    <StackPanel Grid.Row="2" Spacing="8">

      <Border Classes="row" Padding="16,14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0" Data="{StaticResource IconLock}" Stretch="Uniform"
                Width="18" Height="18" StrokeThickness="1.6" StrokeLineCap="Round"
                StrokeJoin="Round" Stroke="{StaticResource ConnectedBrush}"
                VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Весь трафик" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="5" Padding="7,2"
                    VerticalAlignment="Center">
              <TextBlock Text="всё остальное" FontSize="9.5"
                         Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="через туннель" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Classes="row" Padding="16,14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0" Data="{StaticResource IconArrowOut}" Stretch="Uniform"
                Width="18" Height="18" StrokeThickness="1.6" StrokeLineCap="Round"
                StrokeJoin="Round" Stroke="{StaticResource WarningBrush}"
                VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="Локальная сеть" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Принтеры, хранилища и шлюз в домашней сети" FontSize="11.5"
                       Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="мимо туннеля" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Classes="row" Padding="16,14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0" Data="{StaticResource IconArrowOut}" Stretch="Uniform"
                Width="18" Height="18" StrokeThickness="1.6" StrokeLineCap="Round"
                StrokeJoin="Round" Stroke="{StaticResource WarningBrush}"
                VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="Адрес самого сервера" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Иначе пакеты к нему ушли бы в туннель, который они же и поднимают"
                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="мимо туннеля" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <TextBlock Classes="subtitle" Margin="4,14,0,0" TextWrapping="Wrap" MaxWidth="640"
                 Text="Пока правила неизменяемые — это ровно то, что уходит в конфигурацию движка. Свои сценарии появятся вместе с выбором маршрута по качеству." />
    </StackPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
