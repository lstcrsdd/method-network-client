  Оболочка: боковая панель с разделами и область содержимого. Форма повторяет
  клиент macOS — один продукт на разных платформах должен выглядеть одинаково,
  иначе это два продукта с общим названием.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Method.App.ViewModels"
        xmlns:c="using:Method.App.Controls"
        x:Class="Method.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Method"
        Icon="avares://Method/Assets/app.ico"
        Width="1180" Height="780"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent">

  <Border Classes="shell" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{DynamicResource BackgroundTopColor}" Offset="0" />
        <GradientStop Color="{DynamicResource BackgroundBottomColor}" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>

    <!--
      Плёнка шума поверх фона и под всем остальным. Без неё градиент на
      развёрнутом окне распадается на широкие ленты с ясными границами: разница
      между верхним и нижним тоном — десяток ступеней восьмибитного канала, и
      растянуть их на тысячу точек высоты без полос нельзя. Шум эти границы
      размывает, а сам не виден.
    -->
    <Panel>
      <c:Dither IsHitTestVisible="False" />

    <Grid RowDefinitions="40,*">

      <!-- Полоса заголовка: тонкая, перетаскиваемая, имя по центру. -->
      <Grid Grid.Row="0" Name="TitleBar" Background="Transparent" PointerPressed="OnTitleBarPressed">
        <TextBlock Text="Method" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Classes="chrome" Click="OnMinimize" ToolTip.Tip="Свернуть">
            <Path Classes="chromeIcon" Data="{DynamicResource IconMinimize}"
                  Stroke="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="chrome" Click="OnMaximize" ToolTip.Tip="Развернуть">
            <Path Classes="chromeIcon" Data="{DynamicResource IconMaximize}"
                  Stroke="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="chrome close" Click="OnClose" ToolTip.Tip="Закрыть">
            <Path Classes="chromeIcon" Data="{DynamicResource IconClose}"
                  Stroke="{Binding $parent[Button].Foreground}" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Тело окна пересобирается при смене оформления, см. RootView. -->
      <Panel Grid.Row="1" Name="Body" />
    </Grid>
    </Panel>
  </Border>
</Window>
