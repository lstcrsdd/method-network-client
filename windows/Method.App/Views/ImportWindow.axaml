  Поле многострочное намеренно: подписку копируют целиком, и заставлять вставлять
  ссылки по одной значит заставлять делать руками то, что умеет разбор.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Method.App.Views.ImportWindow"
        Title="Добавить серверы"
        Width="440" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="Transparent">

  <Border CornerRadius="12" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{DynamicResource BackgroundTopColor}" Offset="0" />
        <GradientStop Color="{DynamicResource BackgroundBottomColor}" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>

    <Grid Margin="20,14,20,18" RowDefinitions="Auto,Auto,*,Auto,Auto">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Name="TitleBar" Background="Transparent"
            PointerPressed="OnTitleBarPressed" Height="30">
        <TextBlock Text="Добавить серверы" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
      </Grid>

      <TextBlock Grid.Row="1" Margin="0,4,0,10" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="Вставьте ссылки hysteria2://, vless://, trojan:// или ss:// — можно несколько, по одной в строке." />

      <TextBox Grid.Row="2" Name="LinksBox" Classes="mono"
               AcceptsReturn="True" TextWrapping="NoWrap"
               VerticalContentAlignment="Top"
               Watermark="hysteria2://…&#10;vless://…&#10;ss://…" />

      <TextBlock Grid.Row="3" Name="Summary" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="False" />

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="0,14,0,0" Spacing="10">
        <Button Classes="secondary" Content="Отмена" Click="OnCancel" />
        <Button Classes="primary" Content="Добавить" Click="OnAdd" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
