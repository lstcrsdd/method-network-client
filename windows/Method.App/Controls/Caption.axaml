<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Method.App.Controls.Caption">
  <Panel VerticalAlignment="Center">
    <TextBlock Name="PlainCaptionText" Classes="plainCaption" VerticalAlignment="Center" />
    <TextBlock Name="CapsCaptionText" Classes="capsCaption" VerticalAlignment="Center" />
  </Panel>
</UserControl>
