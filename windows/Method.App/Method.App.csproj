<Project Sdk="Microsoft.NET.Sdk">

  <!-- Интерфейс и всё, что знает про Windows: привилегированный режим, установка,
       именованный канал, Wintun. Собирается в один самодостаточный Method.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Method</AssemblyName>
    <RootNamespace>Method.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Знак один на все платформы: иконка взята с эталона macOS. Без неё
         Windows рисует у exe пустой лист бумаги — и в панели задач, и в
         проводнике, и в списке установленных программ. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Маска лампового экрана пишется прямо в пиксели: перебирать сотни строк
         через безопасную обёртку тридцать раз в секунду — это выделения на
         каждый кадр там, где хватает одного указателя. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Параметры применяются при publish -r win-x64. Один файл — потому что
         клиент раздаётся как «скопировал и запустил»: россыпь библиотек рядом с
         exe переживает копирование на флешку ровно до первого забытого файла. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Права доступа на именованный канал: без них канал, созданный SYSTEM,
         недоступен обычному пользователю, то есть нашему же интерфейсу. -->
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <!-- Шифрование хранилища ключом текущего пользователя. В базовую поставку
         .NET не входит даже для Windows-целей. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- События сна и пробуждения: без них туннель после закрытия крышки
         выглядит рабочим и не работает. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <!-- Служба Windows: точка входа диспетчера (ServiceBase) и управление
         состоянием (ServiceController). В базовую поставку .NET не входит.
         Писать диспетчер служб руками поверх StartServiceCtrlDispatcher — это
         делегаты, живущие дольше вызова, и своя машина состояний, в которой
         ошибка означает службу, зависшую на запуске. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Method.Core\Method.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/*.ico" />
  </ItemGroup>

  <!-- Граница общего ядра. Библиотеку собирает core/Scripts/build-windows.ps1;
       в репозитории её нет, как и движка. Условие не роняет сборку у того, кто
       ядро ещё не собирал: клиент соберётся, а отсутствие библиотеки скажется
       понятной ошибкой при первом обращении к ней, а не загадочной при сборке. -->
  <ItemGroup>
    <None Include="..\..\core\build\method_core_ffi.dll" Condition="Exists('..\..\core\build\method_core_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>method_core_ffi.dll</Link>
    </None>
  </ItemGroup>

  <!--
    Исходники для бегущей ленты на обзоре. Показываем настоящий код клиента, а
    не набор знаков «под хакера»: клиент открытый, и чужая выдумка на его месте
    была бы единственным враньём на весь экран.

    Файлы выбраны те, что и правда работают в туннеле: сборка конфигурации,
    измерительный контур, исполнитель решений ядра, граница с общим ядром и
    блокировка трафика мимо туннеля. Секретов в них нет и быть не может —
    репозиторий публичный, и бегущие строки при желании сверяются с ним.

    Комментарии лента отбрасывает сама: в ней они читались текстом, а не кодом.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\Method.Core\Core\SingBoxConfigBuilder.cs">
      <LogicalName>source/config.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Method.Core\Core\ProbeLoop.cs">
      <LogicalName>source/probes.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Method.Core\Core\LanePilot.cs">
      <LogicalName>source/pilot.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Method.Core\Native\CoreEngine.cs">
      <LogicalName>source/core.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Services\WfpKillSwitch.cs">
      <LogicalName>source/wfp.cs</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Движок вшивается в exe и извлекается при установке. Файлов нет в
       репозитории — их приносит Scripts/bootstrap.ps1. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Resources\sing-box.exe" Condition="Exists('..\Resources\sing-box.exe')">
      <LogicalName>sing-box.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Resources\wintun.dll" Condition="Exists('..\Resources\wintun.dll')">
      <LogicalName>wintun.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Собрать клиент без движка технически можно — он просто не поднимет туннель.
       Молча выпускать такую сборку нельзя, поэтому publish без движка падает, а
       обычная отладочная сборка предупреждает и продолжает. -->
  <Target Name="ПроверитьДвижок" BeforeTargets="Build">
    <Warning Condition="!Exists('..\Resources\sing-box.exe') Or !Exists('..\Resources\wintun.dll')" Text="Движка нет в Resources — туннель не поднимется. Запусти Scripts\bootstrap.ps1." />
  </Target>

  <Target Name="ПроверитьДвижокПередПубликацией" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('..\Resources\sing-box.exe') Or !Exists('..\Resources\wintun.dll')" Text="Публиковать клиент без движка нельзя: sing-box.exe или wintun.dll отсутствуют. Запусти Scripts\bootstrap.ps1." />
  </Target>

</Project>
